generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  svo
  hsv
}

enum Squad {
  Mobile
  TPE
  Digital
}

// A Team/Tech Lead with only "proposeAllocations" creates a pending line; it
// doesn't count toward Alloué/capacity anywhere until the HSV (or a
// manageAllocations delegate) approves it — which also happens automatically
// the moment they edit it directly.
enum AllocationStatus {
  pending
  approved
}

model User {
  id           String   @id @default(uuid())
  name         String   @unique
  email        String?
  role         Role
  passwordHash String?  @map("password_hash")
  // Extra capabilities grantable to an svo user by the HSV (super admin), on
  // top of their base access — see src/lib/permissions.js for the fixed key
  // list. Always empty/ignored for hsv users, who already have full access.
  permissions  String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")

  projects        Project[]        @relation("ProjectSvo")
  allocationLines AllocationLine[] @relation("AllocationCreatedBy")

  @@map("users")
}

model PoolMember {
  id         String  @id @default(uuid())
  name       String
  email      String?
  squad      Squad
  sousEquipe String  @map("sous_equipe")
  roleTitle  String  @map("role_title")

  allocationLines AllocationLine[]

  @@map("pool_members")
}

model Project {
  id               String   @id @default(uuid())
  name             String
  svoUserId        String   @map("svo_user_id")
  svo              User     @relation("ProjectSvo", fields: [svoUserId], references: [id])
  status           String
  demandSubmitted  Boolean  @default(false) @map("demand_submitted")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  demandLines     DemandLine[]
  allocationLines AllocationLine[]

  @@map("projects")
}

model DemandLine {
  id          String  @id @default(uuid())
  projectId   String  @map("project_id")
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // One row now covers a whole span of weeks (inclusive), not a single one —
  // both are period ids like "2026-W40", ordered so periodStart <= periodEnd.
  periodStart  String  @map("period_start")
  periodEnd    String  @map("period_end")
  // One row for the whole squad breakdown of a range, instead of a separate
  // row per squad — a single "Allocation %" still applies across all three.
  mobileCount  Decimal @default(0) @db.Decimal(10, 2) @map("mobile_count")
  tpeCount     Decimal @default(0) @db.Decimal(10, 2) @map("tpe_count")
  digitalCount Decimal @default(0) @db.Decimal(10, 2) @map("digital_count")
  pct          Decimal? @db.Decimal(6, 4)

  @@index([projectId])
  @@map("demand_lines")
}

// Denormalized (no FKs) so history survives the user/project it refers to
// being renamed or deleted later.
model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  userName    String   @map("user_name")
  action      String
  projectId   String?  @map("project_id")
  projectName String?  @map("project_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

model AllocationLine {
  id           String     @id @default(uuid())
  projectId    String     @map("project_id")
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Same range convention as DemandLine.periodStart/periodEnd.
  periodStart  String     @map("period_start")
  periodEnd    String     @map("period_end")
  poolMemberId String     @map("pool_member_id")
  poolMember   PoolMember @relation(fields: [poolMemberId], references: [id])
  pct          Decimal    @db.Decimal(6, 4)
  createdById  String     @map("created_by")
  createdBy    User       @relation("AllocationCreatedBy", fields: [createdById], references: [id])
  status       AllocationStatus @default(approved)
  // SVO-initiated: "this resource I already got approved is free for
  // something else" — the line stays real/counted until the HSV confirms
  // the release. A null releaseNewPct means a full release (the line is
  // deleted on confirm); a value means a partial release (pct drops to
  // that value and the line survives, keeping the rest of the allocation).
  releaseRequested Boolean  @default(false) @map("release_requested")
  releaseNote      String?  @map("release_note")
  releaseNewPct    Decimal? @db.Decimal(6, 4) @map("release_new_pct")

  @@index([poolMemberId, periodStart, periodEnd])
  @@index([projectId])
  @@map("allocation_lines")
}
