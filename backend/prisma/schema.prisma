generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  svo
  hsv
}

enum Squad {
  Mobile
  TPE
  Digital
}

// A Team/Tech Lead with only "proposeAllocations" creates a pending line; it
// doesn't count toward Alloué/capacity anywhere until the HSV (or a
// manageAllocations delegate) approves it — which also happens automatically
// the moment they edit it directly.
enum AllocationStatus {
  pending
  approved
}

model User {
  id           String   @id @default(uuid())
  name         String   @unique
  email        String?
  role         Role
  passwordHash String?  @map("password_hash")
  // Extra capabilities grantable to an svo user by the HSV (super admin), on
  // top of their base access — see src/lib/permissions.js for the fixed key
  // list. Always empty/ignored for hsv users, who already have full access.
  permissions  String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at")

  projects        Project[]        @relation("ProjectSvo")
  allocationLines AllocationLine[] @relation("AllocationCreatedBy")

  @@map("users")
}

model PoolMember {
  id         String  @id @default(uuid())
  name       String
  email      String?
  squad      Squad
  sousEquipe String  @map("sous_equipe")
  roleTitle  String  @map("role_title")
  // Atlassian Cloud accountId — Tempo identifies a worklog's author by this,
  // not by name, so matching worklogs back to a PoolMember needs it set
  // explicitly rather than fuzzy-matched (name matching is what broke the
  // ASCII import on "Hamdi AKRAM" vs "Akram Hamdi").
  jiraAccountId String? @map("jira_account_id")

  allocationLines AllocationLine[] @relation("AllocationPrimary")
  backupAllocationLines AllocationLine[] @relation("AllocationBackup")
  unavailabilities Unavailability[]
  loggedTime       LoggedTime[]

  @@map("pool_members")
}

model Project {
  id               String   @id @default(uuid())
  name             String
  svoUserId        String   @map("svo_user_id")
  svo              User     @relation("ProjectSvo", fields: [svoUserId], references: [id])
  status           String
  demandSubmitted  Boolean  @default(false) @map("demand_submitted")
  // Jira project keys — one per espace, since a single Pilotage project can
  // span up to 4 different Jira projects (Mobile/Digital/TPE Android/TPE
  // Engage each have their own Jira space). Any subset may be set; the sync
  // fetches worklogs per key and aggregates them all under this Project.
  jiraProjectKeyMobile     String?  @map("jira_project_key_mobile")
  jiraProjectKeyTpeAndroid String?  @map("jira_project_key_tpe_android")
  jiraProjectKeyTpeEngage  String?  @map("jira_project_key_tpe_engage")
  jiraProjectKeyDigital    String?  @map("jira_project_key_digital")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  demandLines     DemandLine[]
  allocationLines AllocationLine[]
  loggedTime      LoggedTime[]

  @@map("projects")
}

model DemandLine {
  id          String  @id @default(uuid())
  projectId   String  @map("project_id")
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // One row now covers a whole span of weeks (inclusive), not a single one —
  // both are period ids like "2026-W40", ordered so periodStart <= periodEnd.
  periodStart  String  @map("period_start")
  periodEnd    String  @map("period_end")
  // One row for the whole profile breakdown of a range, instead of a
  // separate row per profile — each keeps its own headcount AND its own
  // allocation % (null = 100%). TPE splits into its two sous-équipes
  // (Android/Engage) since that squad alone has more than one; Mobile and
  // Digital each have exactly one sous-équipe matching the squad name, so
  // they don't need the same split.
  mobileCount     Decimal  @default(0) @db.Decimal(10, 2) @map("mobile_count")
  tpeAndroidCount Decimal  @default(0) @db.Decimal(10, 2) @map("tpe_android_count")
  tpeEngageCount  Decimal  @default(0) @db.Decimal(10, 2) @map("tpe_engage_count")
  digitalCount    Decimal  @default(0) @db.Decimal(10, 2) @map("digital_count")
  mobilePct       Decimal? @db.Decimal(6, 4) @map("mobile_pct")
  tpeAndroidPct   Decimal? @db.Decimal(6, 4) @map("tpe_android_pct")
  tpeEngagePct    Decimal? @db.Decimal(6, 4) @map("tpe_engage_pct")
  digitalPct      Decimal? @db.Decimal(6, 4) @map("digital_pct")
  // Free-text note the SVO can attach to this specific period range —
  // context a headcount breakdown alone can't carry (why it's urgent, a
  // constraint on who can do it, etc). Per line, not per project: each
  // period range can have its own story.
  comment         String?  @map("comment")

  @@index([projectId])
  @@map("demand_lines")
}

// Denormalized (no FKs) so history survives the user/project it refers to
// being renamed or deleted later.
model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  userName    String   @map("user_name")
  action      String
  projectId   String?  @map("project_id")
  projectName String?  @map("project_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

model AllocationLine {
  id           String     @id @default(uuid())
  projectId    String     @map("project_id")
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Same range convention as DemandLine.periodStart/periodEnd.
  periodStart  String     @map("period_start")
  periodEnd    String     @map("period_end")
  poolMemberId String     @map("pool_member_id")
  poolMember   PoolMember @relation("AllocationPrimary", fields: [poolMemberId], references: [id])
  // Optional alternate candidate for this same slot (same sous-équipe),
  // picked by whoever proposes/assigns the line — purely informational for
  // now (who to reach for if the primary falls through), no automatic swap.
  backupPoolMemberId String?     @map("backup_pool_member_id")
  backupPoolMember   PoolMember? @relation("AllocationBackup", fields: [backupPoolMemberId], references: [id], onDelete: SetNull)
  pct          Decimal    @db.Decimal(6, 4)
  createdById  String     @map("created_by")
  createdBy    User       @relation("AllocationCreatedBy", fields: [createdById], references: [id])
  status       AllocationStatus @default(approved)
  // Whoever creates the line (a Team/Tech Lead proposing, or an admin
  // assigning directly) can explain their pick here — why this person, any
  // caveat. Separate from validationComment below: that one belongs to
  // whoever approves, which may be a different person at a different time.
  comment           String?  @map("comment")
  validationComment String?  @map("validation_comment")
  // SVO-initiated: "this resource I already got approved is free for
  // something else" — the line stays real/counted until the HSV confirms
  // the release. A null releaseNewPct means a full release (the line is
  // deleted on confirm); a value means a partial release (pct drops to
  // that value and the line survives, keeping the rest of the allocation).
  releaseRequested Boolean  @default(false) @map("release_requested")
  releaseNote      String?  @map("release_note")
  releaseNewPct    Decimal? @db.Decimal(6, 4) @map("release_new_pct")

  @@index([poolMemberId, periodStart, periodEnd])
  @@index([projectId])
  @@map("allocation_lines")
}

// Weekly-aggregated hours pulled from Tempo (or, in principle, any future
// timesheet source) — a cache the sync script upserts into, same pattern as
// Unavailability. The unique constraint makes re-running the sync
// idempotent: it updates hours instead of duplicating rows.
model LoggedTime {
  id           String     @id @default(uuid())
  poolMemberId String     @map("pool_member_id")
  poolMember   PoolMember @relation(fields: [poolMemberId], references: [id], onDelete: Cascade)
  projectId    String?    @map("project_id")
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  period       String     // ISO week id, e.g. "2026-W38" — see lib/periods.js isoWeekId()
  hours        Decimal    @db.Decimal(6, 2)
  source       String     @default("tempo")
  syncedAt     DateTime   @updatedAt @map("synced_at")

  @@unique([poolMemberId, projectId, period, source])
  @@index([poolMemberId, period])
  @@map("logged_time")
}

model Unavailability {
  id           String     @id @default(uuid())
  poolMemberId String     @map("pool_member_id")
  poolMember   PoolMember @relation(fields: [poolMemberId], references: [id], onDelete: Cascade)
  startDate    DateTime   @map("start_date")
  endDate      DateTime   @map("end_date")
  type         String     // congé, maladie, formation, autre
  comment      String?
  source       String     @default("manual") // manual, ascii
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([poolMemberId, startDate, endDate])
  @@map("unavailabilities")
}
