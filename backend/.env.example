DATABASE_URL="postgresql://user@localhost:5432/pilotage_ressources?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Optional: real email sending for notifications (see src/lib/notify.js).
# Leave SMTP_HOST unset to just log notifications to the console instead.
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="notifications@ms-solutions.example"
# SMTP_PASS="app-password"
# SMTP_FROM="Pilotage ressources <notifications@ms-solutions.example>"
# Optional: public URL of the frontend — adds an "Ouvrir Pilotage ressources"
# button to every notification email.
# APP_URL="http://172.16.100.17:5173"

# Optional: Tempo Timesheets sync (scripts/sync-tempo-worklogs.js, POST
# /api/admin/sync-tempo). Generate in Tempo: Settings → Data Access → API
# Integration → New Token (scope: Worklogs).
# TEMPO_API_TOKEN="your-tempo-api-token"
